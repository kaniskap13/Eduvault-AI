# ---------------- BACKEND ONLY (backend/.env) ----------------
# Never commit real values. Never put these in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
PASSWORD_RESET_REDIRECT=http://localhost:5173/reset-password
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_BYTES=10485760

# AI layer: "mock" needs no key. Set a real provider + key to enable it.
AI_PROVIDER=mock
AI_API_KEY=

# Dev only: password given to demo users by `npm run seed` (min 12 chars)
SEED_DEMO_PASSWORD=

# ---------------- FRONTEND (frontend/.env) ----------------
# Public values only. The browser never receives a Supabase key.
VITE_API_BASE_URL=http://localhost:4000/api

# Dev only — used by `npm run test:rls` (local Supabase default shown). NEVER point at production.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
